# Secrets for Edge Functions. Copy to `supabase/functions/.env` for local
# development (`supabase start` / `supabase functions serve` load it
# automatically), and push them to the hosted project with:
#
#   supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform, so
# they don't belong here.

# Secret key from the Stripe dashboard (Developers > API keys).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (Developers > Webhooks), or from
# `stripe listen --print-secret` in local dev.
STRIPE_WEBHOOK_SECRET=

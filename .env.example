# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key (Project Settings > API in the Supabase dashboard).
# Server-only — never expose this to the browser. Used by the billing
# server action to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Loops
LOOPS_API_KEY=

# Stripe
# Secret key from the Stripe dashboard (Developers > API keys).
STRIPE_SECRET_KEY=
# Price ID for the recurring $20/month "Pro" price (Product catalog).
STRIPE_PRICE_ID_PRO=

# The webhook itself runs as the `stripe-webhook` Supabase Edge Function, not
# in this app. Its STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET live in Edge
# Function secrets; see supabase/functions/.env.example.
